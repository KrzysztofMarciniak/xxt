+  for (; n > 0; --n) {
+    x += step;
+    while (x >= 0 && x < cols && cell_ch(vy * cols + x) != ch)
+      x += step;
+    if (x < 0 || x >= cols)
+      return;
+  }
+
+  if (till)
+    x -= step;
+  vx = x;
+}
