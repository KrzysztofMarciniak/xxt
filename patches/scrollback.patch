+static void history_push(void) {
+  char *s;
+  int len, idx;
+
+  for (len = cols; len > 0 && cells[len - 1] == ' '; --len)
+    ;
+
+  s = (char *)malloc(len ? (size_t)len : 1);
+  if (!s)
+    return;
+  memcpy(s, cells, (size_t)len);
+
+  if (hcount == SCROLLBACK) {
+    idx = hstart;
+    free(hline[idx]);
+    hstart = (hstart + 1) % SCROLLBACK;
+  } else {
+    idx = (hstart + hcount++) % SCROLLBACK;
+  }
+
+  hline[idx] = s;
+  hlen[idx] = len;
+
+  if (scroll_off > 0 && scroll_off < hcount)
+    ++scroll_off;
+}
