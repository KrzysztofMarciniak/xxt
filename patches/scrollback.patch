+/* wheel and Shift+PageUp/PageDown/Home/End; returns 1 when handled */
+static int scroll_event(XEvent *e) {
+  KeySym key;
+  unsigned int m;
+
+  if (e->type == ButtonPress && e->xbutton.button == Button4) {
+    scroll_to(scroll_off + WHEEL_LINES);
+    return 1;
+  }
+  if (e->type == ButtonPress && e->xbutton.button == Button5) {
+    scroll_to(scroll_off - WHEEL_LINES);
+    return 1;
+  }
+
+  if (e->type != KeyPress)
+    return 0;
+
+  m = e->xkey.state & (ShiftMask | ControlMask | Mod1Mask);
+  key = XLookupKeysym(&e->xkey, 0);
+  if (m != ShiftMask)
+    return 0;
+
+  if (key == XK_Prior)
+    scroll_to(scroll_off + rows / 2);
+  else if (key == XK_Next)
+    scroll_to(scroll_off - rows / 2);
+  else if (key == XK_Home)
+    scroll_to(hcount);
+  else if (key == XK_End)
+    scroll_to(0);
+  else
+    return 0;
+
+  return 1;
+}
