+static int put_num(char *out, int v) {
+  char tmp[12];
+  int n, i;
+
+  n = 0;
+  do {
+    tmp[n++] = (char)('0' + v % 10);
+    v /= 10;
+  } while (v);
+
+  for (i = 0; i < n; ++i)
+    out[i] = tmp[n - 1 - i];
+
+  return n;
+}
+
+static void draw_scroll(void) {
+  char *line, tag[32];
+  int y, v, idx, len, n;
+
+  line = (char *)malloc((size_t)cols);
+  if (!line)
+    return;
+
+  XClearWindow(display, window);
+  XSetForeground(display, gc, fg);
+  XSetBackground(display, gc, bg);
+
+  for (y = 0; y < rows; ++y) {
+    v = hcount - scroll_off + y;
+
+    if (v >= hcount) {
+      XDrawImageString(display, window, gc, 0, y * fh + font->ascent,
+                       cells + (size_t)(v - hcount) * cols, cols);
+      continue;
+    }
+
+    idx = (hstart + v) % SCROLLBACK;
+    len = hlen[idx] < cols ? hlen[idx] : cols;
+    memset(line, ' ', (size_t)cols);
+    memcpy(line, hline[idx], (size_t)len);
+    XDrawImageString(display, window, gc, 0, y * fh + font->ascent, line,
+                     cols);
+  }
+
+  free(line);
+
+  n = 0;
+  tag[n++] = '[';
+  n += put_num(tag + n, scroll_off);
+  tag[n++] = '/';
+  n += put_num(tag + n, hcount);
+  tag[n++] = ']';
+
+  if (n <= cols) {
+    XSetForeground(display, gc, bg);
+    XSetBackground(display, gc, fg);
+    XDrawImageString(display, window, gc, (cols - n) * fw, font->ascent, tag,
+                     n);
+  }
+
+  XFlush(display);
+}
+
+static void redraw(void) {
+  if (scroll_off)
+    draw_scroll();
+  else
+    draw();
+}
+
+static int scroll_event(XEvent *e) {
+  KeySym key;
+  int handled;
+
+  handled = 0;
+
+  if (e->type == ButtonPress &&
+      (e->xbutton.button == Button4 || e->xbutton.button == Button5)) {
+    scroll_off += e->xbutton.button == Button4 ? 3 : -3;
+    handled = 1;
+  } else if (e->type == KeyPress) {
+    key = XLookupKeysym(&e->xkey, 0);
+
+    if ((e->xkey.state & ShiftMask) &&
+        (key == XK_Prior || key == XK_Next || key == XK_Home ||
+         key == XK_End)) {
+      if (key == XK_Prior)
+        scroll_off += rows / 2;
+      else if (key == XK_Next)
+        scroll_off -= rows / 2;
+      else if (key == XK_Home)
+        scroll_off = hcount;
+      else
+        scroll_off = 0;
+      handled = 1;
+    } else if (scroll_off && !IsModifierKey(key)) {
+      scroll_off = 0;
+      draw();
+    }
+  }
+
+  if (!handled)
+    return 0;
+
+  if (scroll_off > hcount)
+    scroll_off = hcount;
+  if (scroll_off < 0)
+    scroll_off = 0;
+
+  redraw();
+  return 1;
+}
