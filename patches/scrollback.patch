+static int put_num(char *out, int v) {
+  char tmp[12];
+  int n, i;
+
+  n = 0;
+  do {
+    tmp[n++] = (char)('0' + v % 10);
+    v /= 10;
+  } while (v);
+
+  for (i = 0; i < n; ++i)
+    out[i] = tmp[n - 1 - i];
+
+  return n;
+}
