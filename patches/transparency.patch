+static void argb_init(void) {
+  XVisualInfo vi;
+  const char *env;
+
+  if (argb_ready)
+    return;
+  argb_ready = 1;
+
+  argb_alpha = OPACITY;
+  env = getenv("XXT_OPACITY");
+  if (env)
+    argb_alpha = atoi(env);
+  if (argb_alpha < 0)
+    argb_alpha = 0;
+  if (argb_alpha >= 255)
+    return;
+
+  if (!XMatchVisualInfo(display, DefaultScreen(display), 32, TrueColor, &vi))
+    return;
