+/* clipboard keys; returns 1 when the key was consumed */
+static int clip_key(KeySym key, unsigned int state) {
+  unsigned int m;
+
+  m = state & (ShiftMask | ControlMask | Mod1Mask);
+
+  if ((key == KEY_COPY || key == (KEY_COPY | 0x20)) && m == KEY_COPY_MOD) {
+    sel_copy(1);
+    return 1;
+  }
+  if ((key == KEY_PASTE || key == (KEY_PASTE | 0x20)) && m == KEY_PASTE_MOD) {
+    paste(a_clip);
+    return 1;
+  }
+  if (key == KEY_PASTE_PRIMARY && m == KEY_PASTE_PRIMARY_MOD) {
+    paste(XA_PRIMARY);
+    return 1;
+  }
+  return 0;
+}
