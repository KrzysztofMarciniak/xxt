+static void draw_sel(void) {
+  int s, e, y, x0, x1;
+
+  if (!sel_on)
+    return;
+
+  sel_range(&s, &e);
+  for (y = s / cols; y <= e / cols; ++y) {
+    x0 = y == s / cols ? s % cols : 0;
+    x1 = y == e / cols ? e % cols : cols - 1;
+    draw_span(y, x0, x1, sel_fg, sel_bg);
+  }
+}
