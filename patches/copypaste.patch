 /* text of screen row y as shown on the window */
 static const char *row_text(int y) { return cells + (size_t)y * cols; }
 
+/* character shown at linear position p of the visible screen */
+static int cell_ch(int p) {
+  return (unsigned char)row_text(p / cols)[p % cols];
+}
+
+static int put_utf8(char *out, unsigned long c) {
+  if (c < 0x80) {
+    out[0] = (char)c;
+    return 1;
+  }
+  if (c < 0x800) {
+    out[0] = (char)(0xc0 | (c >> 6));
+    out[1] = (char)(0x80 | (c & 0x3f));
+    return 2;
+  }
+  if (c < 0x10000) {
+    out[0] = (char)(0xe0 | (c >> 12));
+    out[1] = (char)(0x80 | ((c >> 6) & 0x3f));
+    out[2] = (char)(0x80 | (c & 0x3f));
+    return 3;
+  }
+  out[0] = (char)(0xf0 | (c >> 18));
+  out[1] = (char)(0x80 | ((c >> 12) & 0x3f));
+  out[2] = (char)(0x80 | ((c >> 6) & 0x3f));
+  out[3] = (char)(0x80 | (c & 0x3f));
+  return 4;
+}
+
+static int is_word(int c) {
+  if (c >= 128)
+    return 1;
+  return c > ' ' && (isalnum(c) || strchr(WORD_CHARS, c));
+}
+
+/* selection as a pair of linear positions, s <= e */
+static void sel_range(int *s, int *e) {
+  int a, b;
+
+  a = sel_ay * cols + sel_ax;
+  b = sel_by * cols + sel_bx;
+
+  if (a > b) {
+    int t = a;
+    a = b;
+    b = t;
+  }
+
+  if (sel_mode == 1) {
+    if (is_word(cell_ch(a)))
+      while (a % cols > 0 && is_word(cell_ch(a - 1)))
+        --a;
+    if (is_word(cell_ch(b)))
+      while (b % cols < cols - 1 && is_word(cell_ch(b + 1)))
+        ++b;
+  } else if (sel_mode == 2) {
+    a = a / cols * cols;
+    b = b / cols * cols + cols - 1;
+  }
+
+  *s = a;
+  *e = b;
+}
+
+static void clip_set(const char *s, size_t n, int clipboard) {
+  char *copy;
+
+  copy = (char *)malloc(n ? n : 1);
+  if (!copy)
+    return;
+
+  memcpy(copy, s, n);
+  free(clip);
+  clip = copy;
+  clip_len = n;
+
+  XSetSelectionOwner(display, XA_PRIMARY, window, CurrentTime);
+  if (clipboard)
+    XSetSelectionOwner(display, a_clip, window, CurrentTime);
+}
+
+static void sel_copy(int clipboard) {
+  char *buf;
+  size_t n;
+  int s, e, p, end, len, i;
+
+  if (!sel_on)
+    return;
+
+  sel_range(&s, &e);
+  buf = (char *)malloc((size_t)(e - s + 1) * 4 + (size_t)rows + 1);
+  if (!buf)
+    return;
+
+  n = 0;
+  p = s;
+  while (p <= e) {
+    end = (p / cols + 1) * cols - 1;
+    if (end > e)
+      end = e;
+
+    len = end - p + 1;
+    while (len > 0 && cell_ch(p + len - 1) == ' ')
+      --len;
+
+    for (i = 0; i < len; ++i)
+      n += (size_t)put_utf8(buf + n, (unsigned long)cell_ch(p + i));
+
+    if (end < e)
+      buf[n++] = '\n';
+    p = end + 1;
+  }
+
+  clip_set(buf, n, clipboard);
+  free(buf);
+}
+
+static void paste_text(const char *s, size_t n) {
+  char *t;
+  size_t i, off;
+  ssize_t w;
+
+  t = (char *)malloc(n ? n : 1);
+  if (!t)
+    return;
+
+  for (i = 0; i < n; ++i)
+    t[i] = s[i] == '\n' ? '\r' : s[i];
+
+  for (off = 0; off < n; off += (size_t)w) {
+    w = write(ptyfd, t + off, n - off);
+    if (w <= 0)
+      break;
+  }
+
+  free(t);
+}
+
+static void paste(Atom sel) {
+  if (XGetSelectionOwner(display, sel) == window) {
+    if (clip)
+      paste_text(clip, clip_len);
+  } else {
+    XConvertSelection(display, sel, a_utf8, a_prop, window, CurrentTime);
+  }
+}
+
+static void selection_request(XSelectionRequestEvent *rq) {
+  XSelectionEvent ev;
+  Atom targets[3];
+
+  memset(&ev, 0, sizeof ev);
+  ev.type = SelectionNotify;
+  ev.requestor = rq->requestor;
+  ev.selection = rq->selection;
+  ev.target = rq->target;
+  ev.time = rq->time;
+  ev.property = None;
+
+  if (!rq->property)
+    rq->property = rq->target;
+
+  if (rq->target == a_targets) {
+    targets[0] = a_targets;
+    targets[1] = a_utf8;
+    targets[2] = XA_STRING;
+    XChangeProperty(display, rq->requestor, rq->property, XA_ATOM, 32,
+                    PropModeReplace, (unsigned char *)targets, 3);
+    ev.property = rq->property;
+  } else if ((rq->target == a_utf8 || rq->target == XA_STRING) && clip) {
+    XChangeProperty(display, rq->requestor, rq->property, rq->target, 8,
+                    PropModeReplace, (unsigned char *)clip, (int)clip_len);
+    ev.property = rq->property;
+  }
+
+  XSendEvent(display, rq->requestor, False, 0, (XEvent *)&ev);
+}
+
+static void selection_notify(XSelectionEvent *ev) {
+  Atom type;
+  int format;
+  unsigned long n, left;
+  unsigned char *data;
+
+  if (ev->property == None) {
+    if (ev->target == a_utf8)
+      XConvertSelection(display, ev->selection, XA_STRING, a_prop, window,
+                        CurrentTime);
+    return;
+  }
+
+  data = NULL;
+  if (XGetWindowProperty(display, window, ev->property, 0, 65536, True,
+                         AnyPropertyType, &type, &format, &n, &left,
+                         &data) == Success &&
+      data)
+    paste_text((const char *)data, (size_t)n);
+
+  if (data)
+    XFree(data);
+}
+
+static long now_ms(void) {
+  struct timeval tv;
+
+  gettimeofday(&tv, NULL);
+  return (long)tv.tv_sec * 1000L + (long)(tv.tv_usec / 1000);
+}
+
+static void mouse_cell(int px, int py, int *x, int *y) {
+  *x = px / fw;
+  *y = py / fh;
+
+  if (*x < 0)
+    *x = 0;
+  if (*x >= cols)
+    *x = cols - 1;
+  if (*y < 0)
+    *y = 0;
+  if (*y >= rows)
+    *y = rows - 1;
+}
+
+/* returns 1 when the event was a selection / paste event and was handled */
+static int mouse_event(XEvent *e) {
+  static long last_click;
+  static int clicks;
+  int x, y;
+  long t;
+
+  if (e->type == ButtonPress && e->xbutton.button == MOUSE_PASTE_BUTTON) {
+    paste(XA_PRIMARY);
+    return 1;
+  }
+
+  if (!MOUSE_SELECT)
+    return 0;
+
+  if (e->type == ButtonPress && e->xbutton.button == Button1) {
+    mouse_cell(e->xbutton.x, e->xbutton.y, &x, &y);
+
+    t = now_ms();
+    clicks = (t - last_click <= MULTI_CLICK_MS && clicks > 0 && clicks < 3)
+                 ? clicks + 1
+                 : 1;
+    last_click = t;
+
+    sel_ax = sel_bx = x;
+    sel_ay = sel_by = y;
+    sel_mode = clicks - 1;
+    sel_drag = 1;
+    sel_moved = 0;
+    sel_on = clicks > 1;
+    return 1;
+  }
+
+  if (e->type == MotionNotify && sel_drag) {
+    mouse_cell(e->xmotion.x, e->xmotion.y, &x, &y);
+
+    if (x != sel_bx || y != sel_by) {
+      sel_bx = x;
+      sel_by = y;
+      sel_moved = 1;
+      sel_on = 1;
+    }
+    return 1;
+  }
+
+  if (e->type == ButtonRelease && e->xbutton.button == Button1 && sel_drag) {
+    sel_drag = 0;
+
+    if (sel_on && COPY_ON_SELECT)
+      sel_copy(COPY_TO_CLIPBOARD);
+    return 1;
+  }
+
+  return 0;
+}
