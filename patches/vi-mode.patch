+
+static void vi_clamp(void) {
+  if (vy >= rows)
+    vy = rows - 1;
+  if (vy < 0)
+    vy = 0;
+  if (vx >= cols)
+    vx = cols - 1;
+  if (vx < 0)
+    vx = 0;
+}
+
+static void vi_pos(int p) {
+  vy = p / cols;
+  vx = p % cols;
+}
+
+static int first_nonblank(int y) {
+  int x;
+
+  for (x = 0; x < cols - 1 && cell_ch(y * cols + x) == ' '; ++x)
+    ;
+  return x;
+}
+
+static int last_nonblank(int y) {
+  int x;
+
+  for (x = cols - 1; x > 0 && cell_ch(y * cols + x) == ' '; --x)
+    ;
+  return x;
+}
+
+static int cls(int p, int big) {
+  int c;
+
+  c = cell_ch(p);
+  if (c == ' ' || c == 0)
+    return 0;
+  if (big)
+    return 1;
+  return (c >= 128 || isalnum(c) || c == '_') ? 1 : 2;
+}
+
+static int word_fwd(int p, int big) {
+  int c, end;
+
+  end = cols * rows - 1;
+  c = cls(p, big);
+  if (c)
+    while (p < end && p / cols == (p + 1) / cols && cls(p + 1, big) == c)
+      ++p;
+  if (p < end)
+    ++p;
+  while (p < end && cls(p, big) == 0)
+    ++p;
+  return p;
+}
+
+static int word_end(int p, int big) {
+  int c, end;
+
+  end = cols * rows - 1;
+  if (p < end)
+    ++p;
+  while (p < end && cls(p, big) == 0)
+    ++p;
+  c = cls(p, big);
+  if (c)
+    while (p < end && p / cols == (p + 1) / cols && cls(p + 1, big) == c)
+      ++p;
+  return p;
+}
+
+static int word_back(int p, int big) {
+  int c;
+
+  if (p > 0)
+    --p;
+  while (p > 0 && cls(p, big) == 0)
+    --p;
+  c = cls(p, big);
+  if (c)
+    while (p > 0 && p / cols == (p - 1) / cols && cls(p - 1, big) == c)
+      --p;
+  return p;
+}
+
+static void vi_find(int cmd, int ch, int n, int repeat) {
+  int x, step, till;
+
+  step = (cmd == 'f' || cmd == 't') ? 1 : -1;
+  till = (cmd == 't' || cmd == 'T');
+  x = vx;
+
+  if (till && repeat)
+    x += step;
+
+  for (; n > 0; --n) {
+    x += step;
+    while (x >= 0 && x < cols && cell_ch(vy * cols + x) != ch)
+      x += step;
+    if (x < 0 || x >= cols)
+      return;
+  }
+
+  if (till)
+    x -= step;
+  vx = x;
+}
+
+static int match_at(int p) {
+  int k;
+
+  if (p % cols + search_len > cols)
+    return 0;
+  for (k = 0; k < search_len; ++k)
+    if (cell_ch(p + k) != (unsigned char)search[k])
+      return 0;
+  return 1;
+}
+
+static void vi_search(int dir) {
+  int total, start, p, i;
+
+  total = cols * rows;
+  if (search_len < 1 || search_len > cols)
+    return;
+
+  start = vy * cols + vx;
+  for (i = 1; i <= total; ++i) {
+    p = ((start + dir * i) % total + total) % total;
+    if (match_at(p)) {
+      vi_pos(p);
+      return;
+    }
+  }
+}
+
+static void vi_match(void) {
+  static const char pairs[] = "()[]{}";
+  const char *q;
+  int p, i, d, depth, total, open, close_;
+
+  total = cols * rows;
+  p = vy * cols + vx;
+  q = cell_ch(p) ? strchr(pairs, cell_ch(p)) : NULL;
+  if (!q)
+    return;
+
+  i = (int)(q - pairs);
+  d = (i & 1) ? -1 : 1;
+  open = pairs[i & ~1];
+  close_ = pairs[i | 1];
+  depth = 0;
+
+  for (; p >= 0 && p < total; p += d) {
+    if (cell_ch(p) == open)
+      ++depth;
+    else if (cell_ch(p) == close_)
+      --depth;
+    if (depth == 0) {
+      vi_pos(p);
+      return;
+    }
+  }
+}
+
+static void vi_yank(void) {
+  sel_ax = ax;
+  sel_ay = ay;
+  sel_bx = vx;
+  sel_by = vy;
+  sel_mode = vmode == VI_LINE ? 2 : 0;
+  sel_on = 1;
+  sel_copy(1);
+  sel_on = 0;
+}
+
+static void yank_lines(int n) {
+  ay = vy;
+  ax = 0;
+  vy += n - 1;
+  vi_clamp();
+  vmode = VI_LINE;
+  vi_yank();
+  set_mode(VI_INPUT);
+}
+
+static void vi_enter(void) {
+  vy = cy;
+  vx = cx;
+  vi_clamp();
+  set_mode(VI_NORMAL);
+}
+
+static void vi_key(KeySym key, int c) {
+  int n, i, p, have, cmd;
+
+  if (searching) {
+    if (c == 27) {
+      searching = 0;
+      set_mode(vmode);
+    } else if (c == '\r' || c == '\n') {
+      if (qlen > 0) {
+        memcpy(search, qbuf, (size_t)qlen);
+        search_len = qlen;
+      }
+      n = vcount > 0 ? vcount : 1;
+      for (i = 0; i < n; ++i)
+        vi_search(search_dir);
+      set_mode(vmode);
+    } else if (c == 8 || c == 127) {
+      if (qlen > 0) {
+        --qlen;
+        search_title();
+      } else {
+        searching = 0;
+        set_mode(vmode);
+      }
+    } else if (c >= 32 && c < 127 && qlen < (int)sizeof qbuf) {
+      qbuf[qlen++] = (char)c;
+      search_title();
+    }
+    return;
+  }
+
+  switch (key) {
+  case XK_Left:
+  case XK_BackSpace:
+    c = 'h';
+    break;
+  case XK_Right:
+    c = 'l';
+    break;
+  case XK_Up:
+    c = 'k';
+    break;
+  case XK_Down:
+    c = 'j';
+    break;
+  case XK_Home:
+    c = '^';
+    break;
+  case XK_End:
+    c = '$';
+    break;
+  case XK_Prior:
+    c = 2;
+    break;
+  case XK_Next:
+    c = 6;
+    break;
+  default:
+    break;
+  }
+
+  if (!c)
+    return;
+
+  if (pending) {
+    cmd = pending;
+    pending = 0;
+    n = vcount > 0 ? vcount : 1;
+
+    if (cmd == 'g') {
+      if (c == 'g') {
+        vy = vcount > 0 ? vcount - 1 : 0;
+        vi_clamp();
+        vx = first_nonblank(vy);
+      }
+    } else if (cmd == 'y') {
+      if (c == 'y') {
+        yank_lines(n);
+        return;
+      }
+    } else if (c >= 32) {
+      last_find = cmd;
+      last_char = c;
+      vi_find(cmd, c, n, 0);
+    }
+
+    vcount = 0;
+    return;
+  }
+
+  if ((c >= '1' && c <= '9') || (c == '0' && vcount > 0)) {
+    vcount = vcount * 10 + c - '0';
+    if (vcount > 9999)
+      vcount = 9999;
+    return;
+  }
+
+  have = vcount > 0;
+  n = have ? vcount : 1;
+  p = vy * cols + vx;
+
+  switch (c) {
+  case 27:
+    if (vmode == VI_NORMAL)
+      set_mode(VI_INPUT);
+    else
+      set_mode(VI_NORMAL);
+    return;
+
+  case 'q':
+    set_mode(VI_INPUT);
+    return;
+
+  case 'i':
+    if (vmode == VI_NORMAL) {
+      set_mode(VI_INPUT);
+      return;
+    }
+    break;
+
+  case 'h':
+    vx -= n;
+    break;
+  case 'l':
+  case ' ':
+    vx += n;
+    break;
+  case 'j':
+  case 14:
+    vy += n;
+    break;
+  case 'k':
+  case 16:
+    vy -= n;
+    break;
+
+  case '0':
+    vx = 0;
+    break;
+  case '^':
+    vx = first_nonblank(vy);
+    break;
+  case '$':
+    vx = last_nonblank(vy);
+    break;
+
+  case 'w':
+  case 'W':
+    for (i = 0; i < n; ++i)
+      p = word_fwd(p, c == 'W');
+    vi_pos(p);
+    break;
+  case 'e':
+  case 'E':
+    for (i = 0; i < n; ++i)
+      p = word_end(p, c == 'E');
+    vi_pos(p);
+    break;
+  case 'b':
+  case 'B':
+    for (i = 0; i < n; ++i)
+      p = word_back(p, c == 'B');
+    vi_pos(p);
+    break;
+
+  case 'g':
+    pending = 'g';
+    return;
+  case 'G':
+    vy = have ? vcount - 1 : rows - 1;
+    vi_clamp();
+    vx = first_nonblank(vy);
+    break;
+  case 'H':
+    vy = have ? vcount - 1 : 0;
+    vi_clamp();
+    vx = first_nonblank(vy);
+    break;
+  case 'M':
+    vy = (rows - 1) / 2;
+    vx = first_nonblank(vy);
+    break;
+  case 'L':
+    vy = rows - n;
+    vi_clamp();
+    vx = first_nonblank(vy);
+    break;
+
+  case 4:
+    vy += rows / 2;
+    break;
+  case 21:
+    vy -= rows / 2;
+    break;
+  case 6:
+    vy += rows - 1;
+    break;
+  case 2:
+    vy -= rows - 1;
+    break;
+
+  case 'f':
+  case 'F':
+  case 't':
+  case 'T':
+    pending = c;
+    return;
+  case ';':
+    if (last_find)
+      vi_find(last_find, last_char, n, 1);
+    break;
+  case ',':
+    if (last_find)
+      vi_find(last_find ^ 0x20, last_char, n, 1);
+    break;
+
+  case '%':
+    vi_match();
+    break;
+
+  case '/':
+  case '?':
+    searching = 1;
+    search_dir = c == '/' ? 1 : -1;
+    qlen = 0;
+    search_title();
+    return;
+  case 'n':
+  case 'N':
+    for (i = 0; i < n; ++i)
+      vi_search(c == 'n' ? search_dir : -search_dir);
+    break;
+
+  case 'v':
+  case 'V':
+    cmd = c == 'v' ? VI_VISUAL : VI_LINE;
+    if (vmode == VI_NORMAL) {
+      ay = vy;
+      ax = vx;
+    }
+    set_mode(vmode == cmd ? VI_NORMAL : cmd);
+    return;
+  case 'o':
+  case 'O':
+    if (vmode != VI_NORMAL) {
+      i = ax;
+      ax = vx;
+      vx = i;
+      i = ay;
+      ay = vy;
+      vy = i;
+    }
+    break;
+
+  case 'y':
+    if (vmode == VI_NORMAL) {
+      pending = 'y';
+      return;
+    }
+    vi_yank();
+    set_mode(VI_INPUT);
+    return;
+  case 'Y':
+    yank_lines(n);
+    return;
+  case '\r':
+  case '\n':
+    if (vmode != VI_NORMAL)
+      vi_yank();
+    set_mode(VI_INPUT);
+    return;
+
+  case 'p':
+  case 'P':
+    paste(a_clip);
+    set_mode(VI_INPUT);
+    return;
+
+  default:
+    break;
+  }
+
+  vi_clamp();
+  vcount = 0;
+}
+
+
+static int handle_key(KeySym key, int c, unsigned int state) {
+  unsigned int m;
+
+  m = state & (ShiftMask | ControlMask | Mod1Mask);
+
+  if (vmode == VI_INPUT) {
+    if (key == VI_ENTER_KEY && m == VI_ENTER_MOD) {
+      vi_enter();
+      return 1;
+    }
+    if (key == XK_Escape && m == VI_SEND_ESC_MOD) {
+      paste_text("\033", 1);
+      return 1;
+    }
+    return 0;
+  }
+
+  vi_key(key, c);
+  return 1;
+}
