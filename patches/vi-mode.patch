+static void set_mode(int m) {
+  static const char *names[] = {"xxt", "xxt [NORMAL]", "xxt [VISUAL]",
+                                "xxt [V-LINE]"};
+
+  vmode = m;
+  vcount = 0;
+  pending = 0;
+  searching = 0;
+  XStoreName(display, window, names[m]);
+}
+
+static void search_title(void) {
+  char title[160];
+
+  snprintf(title, sizeof title, "xxt %c%.*s", search_dir > 0 ? '/' : '?', qlen,
+           qbuf);
+  XStoreName(display, window, title);
+}
+
+static void vi_clamp(void) {
+  if (vy >= rows)
+    vy = rows - 1;
+  if (vy < 0)
+    vy = 0;
+  if (vx >= cols)
+    vx = cols - 1;
+  if (vx < 0)
+    vx = 0;
+}
+
+static void vi_pos(int p) {
+  vy = p / cols;
+  vx = p % cols;
+}
+
+static int first_nonblank(int y) {
+  int x;
+
+  for (x = 0; x < cols - 1 && cells[(size_t)y * cols + x] == ' '; ++x)
+    ;
+  return x;
+}
+
+static int last_nonblank(int y) {
+  int x;
+
+  for (x = cols - 1; x > 0 && cells[(size_t)y * cols + x] == ' '; --x)
+    ;
+  return x;
+}
+
+static int cls(int p, int big) {
+  char c;
+
+  c = cells[p];
+  if (c == ' ')
+    return 0;
+  if (big)
+    return 1;
+  return (isalnum((unsigned char)c) || c == '_') ? 1 : 2;
+}
+
+static int word_fwd(int p, int big) {
+  int c, end;
+
+  end = cols * rows - 1;
+  c = cls(p, big);
+  if (c)
+    while (p < end && p / cols == (p + 1) / cols && cls(p + 1, big) == c)
+      ++p;
+  if (p < end)
+    ++p;
+  while (p < end && cls(p, big) == 0)
+    ++p;
+  return p;
+}
+
+static int word_end(int p, int big) {
+  int c, end;
+
+  end = cols * rows - 1;
+  if (p < end)
+    ++p;
+  while (p < end && cls(p, big) == 0)
+    ++p;
+  c = cls(p, big);
+  if (c)
+    while (p < end && p / cols == (p + 1) / cols && cls(p + 1, big) == c)
+      ++p;
+  return p;
+}
+
+static int word_back(int p, int big) {
+  int c;
+
+  if (p > 0)
+    --p;
+  while (p > 0 && cls(p, big) == 0)
+    --p;
+  c = cls(p, big);
+  if (c)
+    while (p > 0 && p / cols == (p - 1) / cols && cls(p - 1, big) == c)
+      --p;
+  return p;
+}
+
+static void vi_find(int cmd, int ch, int n, int repeat) {
+  char *row;
+  int x, step, till;
+
+  step = (cmd == 'f' || cmd == 't') ? 1 : -1;
+  till = (cmd == 't' || cmd == 'T');
+  row = cells + (size_t)vy * cols;
+  x = vx;
+
+  if (till && repeat)
+    x += step;
+
+  for (; n > 0; --n) {
+    x += step;
+    while (x >= 0 && x < cols && row[x] != ch)
+      x += step;
+    if (x < 0 || x >= cols)
+      return;
+  }
+
+  if (till)
+    x -= step;
+  vx = x;
+}
+
+static void vi_search(int dir) {
+  int total, start, p, i;
+
+  total = cols * rows;
+  if (search_len < 1 || search_len > cols)
+    return;
+
+  start = vy * cols + vx;
+  for (i = 1; i <= total; ++i) {
+    p = ((start + dir * i) % total + total) % total;
+    if (p % cols + search_len <= cols &&
+        !memcmp(cells + p, search, (size_t)search_len)) {
+      vi_pos(p);
+      return;
+    }
+  }
+}
+
+static void vi_match(void) {
+  static const char pairs[] = "()[]{}";
+  const char *q;
+  int p, i, d, depth, total, open, close_;
+
+  total = cols * rows;
+  p = vy * cols + vx;
+  q = strchr(pairs, cells[p]);
+  if (!q)
+    return;
+
+  i = (int)(q - pairs);
+  d = (i & 1) ? -1 : 1;
+  open = pairs[i & ~1];
+  close_ = pairs[i | 1];
+  depth = 0;
+
+  for (; p >= 0 && p < total; p += d) {
+    if (cells[p] == open)
+      ++depth;
+    else if (cells[p] == close_)
+      --depth;
+    if (depth == 0) {
+      vi_pos(p);
+      return;
+    }
+  }
+}
+
+static void sel_range(int *s, int *e) {
+  int a, b;
+
+  a = ay * cols + ax;
+  b = vy * cols + vx;
+
+  if (vmode == VI_LINE) {
+    *s = (ay < vy ? ay : vy) * cols;
+    *e = ((ay > vy ? ay : vy) + 1) * cols - 1;
+  } else {
+    *s = a < b ? a : b;
+    *e = a < b ? b : a;
+  }
+}
+
+static void yank(void) {
+  char *buf;
+  size_t n;
+  int s, e, p, end, len;
+
+  sel_range(&s, &e);
+  buf = (char *)malloc((size_t)(e - s + 1) + (size_t)rows + 1);
+  if (!buf)
+    return;
+
+  n = 0;
+  p = s;
+  while (p <= e) {
+    end = (p / cols + 1) * cols - 1;
+    if (end > e)
+      end = e;
+
+    len = end - p + 1;
+    while (len > 0 && cells[p + len - 1] == ' ')
+      --len;
+
+    memcpy(buf + n, cells + p, (size_t)len);
+    n += (size_t)len;
+
+    if (end < e)
+      buf[n++] = '\n';
+    p = end + 1;
+  }
+
+  free(clip);
+  clip = buf;
+  clip_len = n;
+
+  XSetSelectionOwner(display, XA_PRIMARY, window, CurrentTime);
+  XSetSelectionOwner(display, a_clip, window, CurrentTime);
+}
+
+static void yank_lines(int n) {
+  ay = vy;
+  ax = 0;
+  vy += n - 1;
+  vi_clamp();
+  vmode = VI_LINE;
+  yank();
+  set_mode(VI_INPUT);
+}
+
+static void paste_text(const char *s, size_t n) {
+  char *t;
+  size_t i, off;
+  ssize_t w;
+
+  t = (char *)malloc(n ? n : 1);
+  if (!t)
+    return;
+
+  for (i = 0; i < n; ++i)
+    t[i] = s[i] == '\n' ? '\r' : s[i];
+
+  for (off = 0; off < n; off += (size_t)w) {
+    w = write(ptyfd, t + off, n - off);
+    if (w <= 0)
+      break;
+  }
+
+  free(t);
+}
+
+static void paste(Atom sel) {
+  if (XGetSelectionOwner(display, sel) == window) {
+    if (clip)
+      paste_text(clip, clip_len);
+  } else {
+    XConvertSelection(display, sel, a_utf8, a_prop, window, CurrentTime);
+  }
+}
+
+static void selection_request(XSelectionRequestEvent *rq) {
+  XSelectionEvent ev;
+  Atom targets[3];
+
+  memset(&ev, 0, sizeof ev);
+  ev.type = SelectionNotify;
+  ev.requestor = rq->requestor;
+  ev.selection = rq->selection;
+  ev.target = rq->target;
+  ev.time = rq->time;
+  ev.property = None;
+
+  if (!rq->property)
+    rq->property = rq->target;
+
+  if (rq->target == a_targets) {
+    targets[0] = a_targets;
+    targets[1] = a_utf8;
+    targets[2] = XA_STRING;
+    XChangeProperty(display, rq->requestor, rq->property, XA_ATOM, 32,
+                    PropModeReplace, (unsigned char *)targets, 3);
+    ev.property = rq->property;
+  } else if ((rq->target == a_utf8 || rq->target == XA_STRING) && clip) {
+    XChangeProperty(display, rq->requestor, rq->property, rq->target, 8,
+                    PropModeReplace, (unsigned char *)clip, (int)clip_len);
+    ev.property = rq->property;
+  }
+
+  XSendEvent(display, rq->requestor, False, 0, (XEvent *)&ev);
+}
+
+static void selection_notify(XSelectionEvent *ev) {
+  Atom type;
+  int format;
+  unsigned long n, left;
+  unsigned char *data;
+
+  if (ev->property == None) {
+    if (ev->target == a_utf8)
+      XConvertSelection(display, ev->selection, XA_STRING, a_prop, window,
+                        CurrentTime);
+    return;
+  }
+
+  data = NULL;
+  if (XGetWindowProperty(display, window, ev->property, 0, 65536, True,
+                         AnyPropertyType, &type, &format, &n, &left,
+                         &data) == Success &&
+      data)
+    paste_text((const char *)data, (size_t)n);
+
+  if (data)
+    XFree(data);
+}
+
+static void vi_enter(void) {
+  vy = cy;
+  vx = cx;
+  vi_clamp();
+  set_mode(VI_NORMAL);
+}
+
+static void vi_key(KeySym key, int c) {
+  int n, i, p, have, cmd;
+
+  if (searching) {
+    if (c == 27) {
+      searching = 0;
+      set_mode(vmode);
+    } else if (c == '\r' || c == '\n') {
+      if (qlen > 0) {
+        memcpy(search, qbuf, (size_t)qlen);
+        search_len = qlen;
+      }
+      n = vcount > 0 ? vcount : 1;
+      for (i = 0; i < n; ++i)
+        vi_search(search_dir);
+      set_mode(vmode);
+    } else if (c == 8 || c == 127) {
+      if (qlen > 0) {
+        --qlen;
+        search_title();
+      } else {
+        searching = 0;
+        set_mode(vmode);
+      }
+    } else if (c >= 32 && c < 127 && qlen < (int)sizeof qbuf) {
+      qbuf[qlen++] = (char)c;
+      search_title();
+    }
+    return;
+  }
+
+  switch (key) {
+  case XK_Left:
+  case XK_BackSpace:
+    c = 'h';
+    break;
+  case XK_Right:
+    c = 'l';
+    break;
+  case XK_Up:
+    c = 'k';
+    break;
+  case XK_Down:
+    c = 'j';
+    break;
+  case XK_Home:
+    c = '^';
+    break;
+  case XK_End:
+    c = '$';
+    break;
+  case XK_Prior:
+    c = 2;
+    break;
+  case XK_Next:
+    c = 6;
+    break;
+  default:
+    break;
+  }
+
+  if (!c)
+    return;
+
+  if (pending) {
+    cmd = pending;
+    pending = 0;
+    n = vcount > 0 ? vcount : 1;
+
+    if (cmd == 'g') {
+      if (c == 'g') {
+        vy = vcount > 0 ? vcount - 1 : 0;
+        vi_clamp();
+        vx = first_nonblank(vy);
+      }
+    } else if (cmd == 'y') {
+      if (c == 'y') {
+        yank_lines(n);
+        return;
+      }
+    } else if (c >= 32) {
+      last_find = cmd;
+      last_char = c;
+      vi_find(cmd, c, n, 0);
+    }
+
+    vcount = 0;
+    return;
+  }
+
+  if ((c >= '1' && c <= '9') || (c == '0' && vcount > 0)) {
+    vcount = vcount * 10 + c - '0';
+    if (vcount > 9999)
+      vcount = 9999;
+    return;
+  }
+
+  have = vcount > 0;
+  n = have ? vcount : 1;
+  p = vy * cols + vx;
+
+  switch (c) {
+  case 27:
+    set_mode(vmode == VI_NORMAL ? VI_INPUT : VI_NORMAL);
+    return;
+
+  case 'q':
+    set_mode(VI_INPUT);
+    return;
+
+  case 'i':
+    if (vmode == VI_NORMAL) {
+      set_mode(VI_INPUT);
+      return;
+    }
+    break;
+
+  case 'h':
+    vx -= n;
+    break;
+  case 'l':
+  case ' ':
+    vx += n;
+    break;
+  case 'j':
+  case 14:
+    vy += n;
+    break;
+  case 'k':
+  case 16:
+    vy -= n;
+    break;
+
+  case '0':
+    vx = 0;
+    break;
+  case '^':
+    vx = first_nonblank(vy);
+    break;
+  case '$':
+    vx = last_nonblank(vy);
+    break;
+
+  case 'w':
+  case 'W':
+    for (i = 0; i < n; ++i)
+      p = word_fwd(p, c == 'W');
+    vi_pos(p);
+    break;
+  case 'e':
+  case 'E':
+    for (i = 0; i < n; ++i)
+      p = word_end(p, c == 'E');
+    vi_pos(p);
+    break;
+  case 'b':
+  case 'B':
+    for (i = 0; i < n; ++i)
+      p = word_back(p, c == 'B');
+    vi_pos(p);
+    break;
+
+  case 'g':
+    pending = 'g';
+    return;
+  case 'G':
+    vy = have ? vcount - 1 : rows - 1;
+    vi_clamp();
+    vx = first_nonblank(vy);
+    break;
+  case 'H':
+    vy = have ? vcount - 1 : 0;
+    vi_clamp();
+    vx = first_nonblank(vy);
+    break;
+  case 'M':
+    vy = (rows - 1) / 2;
+    vx = first_nonblank(vy);
+    break;
+  case 'L':
+    vy = rows - n;
+    vi_clamp();
+    vx = first_nonblank(vy);
+    break;
+
+  case 4:
+    vy += rows / 2;
+    break;
+  case 21:
+    vy -= rows / 2;
+    break;
+  case 6:
+    vy += rows - 1;
+    break;
+  case 2:
+    vy -= rows - 1;
+    break;
+
+  case 'f':
+  case 'F':
+  case 't':
+  case 'T':
+    pending = c;
+    return;
+  case ';':
+    if (last_find)
+      vi_find(last_find, last_char, n, 1);
+    break;
+  case ',':
+    if (last_find)
+      vi_find(last_find ^ 0x20, last_char, n, 1);
+    break;
+
+  case '%':
+    vi_match();
+    break;
+
+  case '/':
+  case '?':
+    searching = 1;
+    search_dir = c == '/' ? 1 : -1;
+    qlen = 0;
+    search_title();
+    return;
+  case 'n':
+  case 'N':
+    for (i = 0; i < n; ++i)
+      vi_search(c == 'n' ? search_dir : -search_dir);
+    break;
+
+  case 'v':
+  case 'V':
+    cmd = c == 'v' ? VI_VISUAL : VI_LINE;
+    if (vmode == VI_NORMAL) {
+      ay = vy;
+      ax = vx;
+    }
+    set_mode(vmode == cmd ? VI_NORMAL : cmd);
+    return;
+  case 'o':
+  case 'O':
+    if (vmode != VI_NORMAL) {
+      i = ax;
+      ax = vx;
+      vx = i;
+      i = ay;
+      ay = vy;
+      vy = i;
+    }
+    break;
+
+  case 'y':
+    if (vmode == VI_NORMAL) {
+      pending = 'y';
+      return;
+    }
+    yank();
+    set_mode(VI_INPUT);
+    return;
+  case 'Y':
+    yank_lines(n);
+    return;
+  case '\r':
+  case '\n':
+    if (vmode != VI_NORMAL)
+      yank();
+    set_mode(VI_INPUT);
+    return;
+
+  case 'p':
+  case 'P':
+    paste(a_clip);
+    set_mode(VI_INPUT);
+    return;
+
+  default:
+    break;
+  }
+
+  vi_clamp();
+  vcount = 0;
+}
+
+static int handle_key(KeySym key, int c, unsigned int state) {
+  unsigned int cs;
+
+  cs = ControlMask | ShiftMask;
+
+  if (vmode == VI_INPUT) {
+    if (key == XK_space && (state & cs) == cs) {
+      vi_enter();
+      return 1;
+    }
+    if (key == XK_Insert && (state & ShiftMask)) {
+      paste(XA_PRIMARY);
+      return 1;
+    }
+    if ((key == XK_V || key == XK_v) && (state & cs) == cs) {
+      paste(a_clip);
+      return 1;
+    }
+    return 0;
+  }
+
+  vi_key(key, c);
+  return 1;
+}
