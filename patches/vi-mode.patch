+static void set_mode(int m) {
+  static const char *names[] = {WIN_TITLE, WIN_TITLE " [NORMAL]",
+                                WIN_TITLE " [VISUAL]", WIN_TITLE " [V-LINE]"};
+
+  if ((vmode == VI_VISUAL || vmode == VI_LINE) && m != VI_VISUAL &&
+      m != VI_LINE)
+    sel_on = 0;
+
+  vmode = m;
+  vcount = 0;
+  pending = 0;
+  searching = 0;
+  XStoreName(display, window, names[m]);
+}
