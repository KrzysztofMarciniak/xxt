xxt is an extremely small X11 terminal emulator. running memory usage recorded 1.6mb.

config:
	#define FONT "fixed" // default x11 font
	#define BG_COLOR "#000000" // black
	#define FG_COLOR "#ffffff" // white

compile:
	cc -std=c89 -o xxt main.c -lX11 -O2

install:
	install -m 755 xxt /usr/local/bin/xxt

deps:
	libX11. POSIX PTY functions come from libc on glibc.

